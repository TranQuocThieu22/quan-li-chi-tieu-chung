// Chuỗi kết nối nằm ở prisma.config.ts (Prisma 7 không nhận url trong schema)
datasource db {
  provider = "postgresql"
}

// Client sinh vào src/generated/prisma (đã .gitignore), tạo lại ở postinstall
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Tài khoản đăng nhập bằng Google
model User {
  id        Int      @id @default(autoincrement())
  googleId  String   @unique
  email     String   @unique
  name      String
  image     String?
  isSuperAdmin Boolean @default(false)
  // SHA-256 của mã nhận thông báo từ điện thoại (bản gốc chỉ hiện một lần lúc tạo)
  importTokenHash String?
  createdAt DateTime @default(now())

  members          Member[]
  partnershipsAsA  Partnership[] @relation("PartnerA")
  partnershipsAsB  Partnership[] @relation("PartnerB")
  sentInvites      Invitation[]  @relation("InviteFrom")
  receivedInvites  Invitation[]  @relation("InviteTo")
  personalExpenses PersonalExpense[]
  personalBudgets  PersonalBudget[]
  importedTransactions ImportedTransaction[]
  paymentProfile   PaymentProfile?

  // Không để @unique: thêm ràng buộc unique vào bảng đã có dữ liệu làm db push đòi --accept-data-loss và hỏng build
  @@index([importTokenHash])
}

// Ngân sách tháng của một người; tháng không có bản ghi dùng ngân sách gần nhất trước đó, amount = 0 là tắt
model PersonalBudget {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  month     String   // YYYY-MM
  amount    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
}

// Chi tiêu cá nhân: chỉ chủ tài khoản xem được, không liên quan đến sổ chung
model PersonalExpense {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  item      String
  amount    Int
  category  String   @default("other")
  date      DateTime @default(now())
  notes     String?
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

// Hai tài khoản liên kết để quản lý chi tiêu chung.
// userAId luôn nhỏ hơn userBId để mỗi cặp chỉ có một bản ghi; hủy liên kết thì đặt endedAt,
// liên kết lại với cùng người thì mở lại bản ghi cũ (giữ nguyên dữ liệu).
model Partnership {
  id        Int       @id @default(autoincrement())
  userAId   Int
  userA     User      @relation("PartnerA", fields: [userAId], references: [id])
  userBId   Int
  userB     User      @relation("PartnerB", fields: [userBId], references: [id])
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  members  Member[]
  expenses Expense[]

  @@unique([userAId, userBId])
}

model Invitation {
  id          Int       @id @default(autoincrement())
  fromUserId  Int
  fromUser    User      @relation("InviteFrom", fields: [fromUserId], references: [id])
  toUserId    Int
  toUser      User      @relation("InviteTo", fields: [toUserId], references: [id])
  status      String    @default("PENDING") // PENDING | ACCEPTED | DECLINED | CANCELED
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([toUserId, status])
  @@index([fromUserId, status])
}

model Member {
  id                Int          @id @default(autoincrement())
  name              String
  userId            Int?
  user              User?        @relation(fields: [userId], references: [id])
  partnershipId     Int?
  partnership       Partnership? @relation(fields: [partnershipId], references: [id])
  expenses          Expense[]    @relation("PayerRelation")
  benefitedExpenses Expense[]    @relation("BeneficiaryRelation")
  createdAt         DateTime     @default(now())

  @@index([partnershipId, userId])
}

model Expense {
  id            Int          @id @default(autoincrement())
  item          String
  amount        Int
  category      String       @default("other")
  payerId       Int
  payer         Member       @relation("PayerRelation", fields: [payerId], references: [id])
  beneficiaryId Int?
  beneficiary   Member?      @relation("BeneficiaryRelation", fields: [beneficiaryId], references: [id])
  partnershipId Int?
  partnership   Partnership? @relation(fields: [partnershipId], references: [id])
  date          DateTime     @default(now())
  notes         String?
  imageUrl      String?
  isDeleted     Boolean      @default(false)
  // Đã trả: không còn tính vào tổng chi tiêu chung và công nợ
  isSettled     Boolean      @default(false)
  settledAt     DateTime?
  createdAt     DateTime     @default(now())

  histories ExpenseHistory[]

  @@index([partnershipId, date])
}

model ExpenseHistory {
  id                 Int      @id @default(autoincrement())
  expenseId          Int
  expense            Expense  @relation(fields: [expenseId], references: [id])
  action             String

  oldItem            String
  oldAmount          Int
  oldPayerName       String
  oldBeneficiaryName String?
  oldDate            DateTime
  oldNotes           String?
  oldImageUrl        String?
  oldCategory        String? // null với bản ghi tạo trước khi có danh mục

  editedAt           DateTime @default(now())
}

// Thông báo giao dịch chuyển tiếp từ điện thoại (app ngân hàng, MoMo) — chờ người dùng xác nhận thành khoản chi
model ImportedTransaction {
  id                Int       @id @default(autoincrement())
  userId            Int
  user              User      @relation(fields: [userId], references: [id])
  source            String    // tên app gửi thông báo
  title             String?
  text              String    // nội dung gốc, giữ nguyên để soát khi đọc sai
  amount            Int?
  direction         String?   // OUT | IN | null nếu không rõ
  description       String?
  // PENDING: chờ xác nhận | ACCEPTED | DISMISSED | INCOMING: tiền vào, bỏ qua | UNPARSED: không đọc được số tiền
  status            String    @default("PENDING")
  expenseId         Int?
  personalExpenseId Int?
  dedupeKey         String
  occurredAt        DateTime  @default(now())
  receivedAt        DateTime  @default(now())
  resolvedAt        DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, status])
}

// Tài khoản nhận tiền của một người: người cùng sổ thấy mã VietQR (kèm số tiền) ở thẻ "Cần thanh toán".
// Bảng riêng để ảnh QR không bị tải theo User ở mọi request; bảng mới nên @unique không đụng dữ liệu cũ.
model PaymentProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id])
  bankBin     String?  // mã ngân hàng NAPAS, xem src/lib/banks.ts
  bankAccount String?
  accountName String?  // tên chủ tài khoản, in hoa không dấu như trên app ngân hàng
  qrImage     String?  // ảnh mã QR tự tải lên (MoMo, ví khác…), data URL base64
  updatedAt   DateTime @updatedAt
}
