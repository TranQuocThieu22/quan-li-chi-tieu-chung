datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Member {
  id               Int       @id @default(autoincrement())
  name             String
  expenses         Expense[] @relation("PayerRelation")
  benefitedExpenses Expense[] @relation("BeneficiaryRelation")
  createdAt        DateTime  @default(now())
}

model Expense {
  id            Int      @id @default(autoincrement())
  item          String
  amount        Int
  payerId       Int
  payer         Member   @relation("PayerRelation", fields: [payerId], references: [id])
  beneficiaryId Int?
  beneficiary   Member?  @relation("BeneficiaryRelation", fields: [beneficiaryId], references: [id])
  date          DateTime @default(now())
  notes         String?
  imageUrl      String?
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  
  histories ExpenseHistory[]
}

model ExpenseHistory {
  id                 Int      @id @default(autoincrement())
  expenseId          Int
  expense            Expense  @relation(fields: [expenseId], references: [id])
  action             String   
  
  oldItem            String
  oldAmount          Int
  oldPayerName       String
  oldBeneficiaryName String?
  oldDate            DateTime
  oldNotes           String?
  oldImageUrl        String?

  editedAt           DateTime @default(now())
}
